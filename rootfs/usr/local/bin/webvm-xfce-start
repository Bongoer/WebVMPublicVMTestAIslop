#!/bin/sh
set -u

export HOME=/root
export USER=root
export LOGNAME=root
export SHELL=/bin/sh
export DISPLAY=:0
export LIBGL_ALWAYS_SOFTWARE=1
export GALLIUM_DRIVER=llvmpipe

xorg_pid=""
desktop_pid=""

cleanup() {
  [ -n "$desktop_pid" ] && kill "$desktop_pid" 2>/dev/null || true
  [ -n "$xorg_pid" ] && kill "$xorg_pid" 2>/dev/null || true
}

trap cleanup EXIT INT TERM

echo "[1/5] Preparing Linux display"

mkdir -p /tmp/.X11-unix
mkdir -p /tmp/.ICE-unix
mkdir -p /tmp/runtime-user

chmod 1777 /tmp
chmod 1777 /tmp/.X11-unix
chmod 1777 /tmp/.ICE-unix
chmod 700 /tmp/runtime-user

chown user:user /tmp/runtime-user
chown -R user:user /home/user

rm -f /tmp/.X11-unix/X0
rm -f /tmp/.X0-lock

echo "[2/5] Starting graphical server"

/usr/bin/Xorg \
  :0 \
  vt7 \
  -keeptty \
  -noreset \
  -nolisten tcp \
  -ac &

xorg_pid=$!

echo "[3/5] Waiting for graphical socket"

attempt=0

while [ ! -S /tmp/.X11-unix/X0 ]
do
  if ! kill -0 "$xorg_pid" 2>/dev/null
  then
    echo "ERROR: Xorg stopped before creating the display."
    wait "$xorg_pid"
    exit 1
  fi

  attempt=$((attempt + 1))

  if [ "$attempt" -ge 60 ]
  then
    echo "ERROR: Xorg did not create its display socket."
    exit 1
  fi

  sleep 1
done

echo "[4/5] Starting XFCE session"

su-exec user env \
  HOME=/home/user \
  USER=user \
  LOGNAME=user \
  SHELL=/bin/sh \
  DISPLAY=:0 \
  XDG_RUNTIME_DIR=/tmp/runtime-user \
  XDG_CONFIG_HOME=/home/user/.config \
  XDG_CURRENT_DESKTOP=XFCE \
  DESKTOP_SESSION=xfce \
  LIBGL_ALWAYS_SOFTWARE=1 \
  GALLIUM_DRIVER=llvmpipe \
  dbus-run-session sh -c '
    /usr/bin/xfce4-session &
    session_pid=$!

    sleep 6

    echo "[5/5] Starting XFCE window manager"

    /usr/bin/xfwm4 \
      --replace \
      --compositor=off &

    wait "$session_pid"
  ' &

desktop_pid=$!

wait "$desktop_pid"
