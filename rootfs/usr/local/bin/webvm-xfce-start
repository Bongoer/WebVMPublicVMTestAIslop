#!/bin/sh
set -u

export HOME=/root
export USER=root
export LOGNAME=root
export SHELL=/bin/sh
export DISPLAY=:0

xorg_pid=""
xfce_pid=""

cleanup() {
  [ -n "$xfce_pid" ] && kill "$xfce_pid" 2>/dev/null || true
  [ -n "$xorg_pid" ] && kill "$xorg_pid" 2>/dev/null || true
}

trap cleanup EXIT INT TERM

echo "[1/4] Preparing Linux display"

mkdir -p /tmp/.X11-unix
mkdir -p /tmp/runtime-user

chmod 1777 /tmp
chmod 1777 /tmp/.X11-unix
chmod 700 /tmp/runtime-user

chown user:user /tmp/runtime-user
chown -R user:user /home/user

rm -f /tmp/.X11-unix/X0
rm -f /tmp/.X0-lock

echo "[2/4] Starting graphical server"

/usr/bin/Xorg \
  :0 \
  vt7 \
  -keeptty \
  -noreset \
  -nolisten tcp \
  -ac \
  -retro &

xorg_pid=$!

echo "[3/4] Waiting for graphical socket"

attempt=0

while [ ! -S /tmp/.X11-unix/X0 ]
do
  if ! kill -0 "$xorg_pid" 2>/dev/null
  then
    echo "ERROR: Xorg stopped before creating the display."
    wait "$xorg_pid"
    exit 1
  fi

  attempt=$((attempt + 1))

  if [ "$attempt" -ge 60 ]
  then
    echo "ERROR: Xorg did not create its display socket."
    exit 1
  fi

  sleep 1
done

echo "[4/4] Starting XFCE desktop"

su-exec user env \
  HOME=/home/user \
  USER=user \
  LOGNAME=user \
  SHELL=/bin/sh \
  DISPLAY=:0 \
  XDG_RUNTIME_DIR=/tmp/runtime-user \
  XDG_CONFIG_HOME=/home/user/.config \
  XDG_CURRENT_DESKTOP=XFCE \
  DESKTOP_SESSION=xfce \
  dbus-run-session /usr/bin/xfce4-session &

xfce_pid=$!

sleep 5

if ! kill -0 "$xfce_pid" 2>/dev/null
then
  echo "ERROR: XFCE stopped during startup."
  wait "$xfce_pid"
  exit 1
fi

echo "XFCE process is running."

wait "$xfce_pid"
