#!/bin/sh
set -u

export HOME=/root
export USER=root
export LOGNAME=root
export SHELL=/bin/sh
export DISPLAY=:0

xorg_pid=""

cleanup() {
  [ -n "$xorg_pid" ] &&
    kill "$xorg_pid" 2>/dev/null || true
}

trap cleanup EXIT INT TERM

echo "[1/4] Preparing XFCE display"

mkdir -p \
  /tmp/.X11-unix \
  /tmp/.ICE-unix \
  /tmp/runtime-user

chmod 1777 /tmp
chmod 1777 /tmp/.X11-unix
chmod 1777 /tmp/.ICE-unix
chmod 700 /tmp/runtime-user
chown user:user /tmp/runtime-user

rm -f /tmp/.X11-unix/X0
rm -f /tmp/.X0-lock

dbus-uuidgen --ensure=/etc/machine-id 2>/dev/null || true

echo "[2/4] Starting Xorg"

/usr/bin/Xorg \
  :0 \
  vt7 \
  -keeptty \
  -noreset \
  -nolisten tcp \
  -ac \
  -extension GLX \
  -extension DRI2 \
  -extension DRI3 \
  -extension Composite &

xorg_pid=$!

echo "[3/4] Waiting for graphical display"

attempt=0

while [ ! -S /tmp/.X11-unix/X0 ]
do
  if ! kill -0 "$xorg_pid" 2>/dev/null
  then
    echo "ERROR: Xorg stopped."
    wait "$xorg_pid"
    exit 1
  fi

  attempt=$((attempt + 1))

  if [ "$attempt" -ge 300 ]
  then
    echo "ERROR: Xorg did not create display :0."
    exit 1
  fi

  sleep 0.1
done

echo "[4/4] Entering XFCE user session"

exec su-exec user \
  /usr/local/bin/webvm-xfce-session
