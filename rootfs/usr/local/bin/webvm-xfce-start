#!/bin/sh
set -u

export HOME=/root
export USER=root
export LOGNAME=root
export SHELL=/bin/sh
export DISPLAY=:0

xorg_pid=""

cleanup() {
  [ -n "$xorg_pid" ] && kill "$xorg_pid" 2>/dev/null || true
}

trap cleanup EXIT INT TERM

echo "[1/4] Preparing XFCE display"

mkdir -p /tmp/.X11-unix
mkdir -p /tmp/.ICE-unix
mkdir -p /tmp/runtime-user

chmod 1777 /tmp
chmod 1777 /tmp/.X11-unix
chmod 1777 /tmp/.ICE-unix
chmod 700 /tmp/runtime-user

chown user:user /tmp/runtime-user
chown -R user:user /home/user

rm -f /tmp/.X11-unix/X0
rm -f /tmp/.X0-lock
rm -rf /home/user/.cache/sessions

echo "[2/4] Starting CPU-rendered Xorg"

/usr/bin/Xorg \
  :0 \
  vt7 \
  -keeptty \
  -noreset \
  -nolisten tcp \
  -ac \
  -extension GLX \
  -extension DRI2 \
  -extension DRI3 \
  -extension Composite &

xorg_pid=$!

echo "[3/4] Waiting for graphical display"

attempt=0

while [ ! -S /tmp/.X11-unix/X0 ]
do
  if ! kill -0 "$xorg_pid" 2>/dev/null
  then
    echo "ERROR: Xorg stopped."
    wait "$xorg_pid"
    exit 1
  fi

  attempt=$((attempt + 1))

  if [ "$attempt" -ge 60 ]
  then
    echo "ERROR: Xorg did not create display :0."
    exit 1
  fi

  sleep 1
done

echo "[4/4] Starting pure XFCE"

exec su-exec user env \
  HOME=/home/user \
  USER=user \
  LOGNAME=user \
  SHELL=/bin/sh \
  DISPLAY=:0 \
  XDG_RUNTIME_DIR=/tmp/runtime-user \
  XDG_CONFIG_HOME=/home/user/.config \
  XDG_CURRENT_DESKTOP=XFCE \
  DESKTOP_SESSION=xfce \
  GDK_BACKEND=x11 \
  XLIB_SKIP_ARGB_VISUALS=1 \
  dbus-run-session sh -c '
    /usr/bin/xfce4-session &
    session_pid=$!

    sleep 10

    if kill -0 "$session_pid" 2>/dev/null &&
       pgrep -x xfwm4 >/dev/null &&
       pgrep -x xfdesktop >/dev/null &&
       pgrep -x xfce4-panel >/dev/null
    then
      echo "PURE_XFCE_DESKTOP_READY"
    else
      echo "ERROR: One or more XFCE components failed."
      ps
    fi

    wait "$session_pid"
  '
