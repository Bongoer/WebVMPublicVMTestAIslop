#!/bin/sh
set -u

export DISPLAY=:0
export HOME=/home/user
export USER=user
export LOGNAME=user
export SHELL=/bin/sh
export XDG_RUNTIME_DIR=/tmp/runtime-user
export LIBGL_ALWAYS_SOFTWARE=1
export GALLIUM_DRIVER=softpipe

auth_file=/tmp/webvm.Xauthority
xorg_log=/tmp/webvm-xorg.log
xrandr_log=/tmp/webvm-xrandr.log

echo "[1/6] Preparing XFCE environment"

mkdir -p /tmp/.X11-unix
mkdir -p /tmp/runtime-user

chmod 1777 /tmp
chmod 1777 /tmp/.X11-unix
chmod 700 /tmp/runtime-user
chown user:user /tmp/runtime-user

rm -f /tmp/.X11-unix/X0
rm -f /tmp/.X0-lock
rm -f "$auth_file"
rm -f "$xorg_log"
rm -f "$xrandr_log"

echo "[2/6] Creating X authorization"

touch "$auth_file"
cookie="$(mcookie)"

xauth -f "$auth_file" add :0 . "$cookie"

chown user:user "$auth_file"
chmod 600 "$auth_file"

echo "[3/6] Starting Xorg on graphical VT7"

/usr/bin/Xorg   :0   vt7   -keeptty   -noreset   -nolisten tcp   -auth "$auth_file"   >"$xorg_log" 2>&1 &

xorg_pid=$!

cleanup() {
  kill "$xorg_pid" 2>/dev/null || true
}

trap cleanup EXIT INT TERM

echo "[4/6] Waiting until the user can access display :0"

attempt=0

while true
do
  if ! kill -0 "$xorg_pid" 2>/dev/null
  then
    echo "ERROR: Xorg stopped."
    tail -n 100 "$xorg_log"
    wait "$xorg_pid"
    exit 1
  fi

  if su-exec user env     DISPLAY=:0     XAUTHORITY="$auth_file"     /usr/bin/xrandr --query     >"$xrandr_log" 2>&1
  then
    break
  fi

  attempt=$((attempt + 1))

  if [ "$attempt" -ge 90 ]
  then
    echo "ERROR: user could not connect to Xorg after 90 seconds."
    echo
    echo "Xorg log:"
    tail -n 100 "$xorg_log"
    echo
    echo "Connection test:"
    cat "$xrandr_log"
    exit 1
  fi

  sleep 1
done

echo "[5/6] Display :0 is accessible"
echo "[6/6] Launching the actual XFCE session"

exec su-exec user env   HOME=/home/user   USER=user   LOGNAME=user   SHELL=/bin/sh   DISPLAY=:0   XAUTHORITY="$auth_file"   XDG_RUNTIME_DIR=/tmp/runtime-user   XDG_CURRENT_DESKTOP=XFCE   DESKTOP_SESSION=xfce   LIBGL_ALWAYS_SOFTWARE=1   GALLIUM_DRIVER=softpipe   dbus-run-session /usr/bin/xfce4-session
