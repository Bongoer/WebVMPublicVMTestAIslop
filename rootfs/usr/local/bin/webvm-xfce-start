#!/bin/sh

export DISPLAY=:0
export HOME=/home/user
export USER=user
export LOGNAME=user
export SHELL=/bin/sh
export XDG_RUNTIME_DIR=/tmp/runtime-user
export LIBGL_ALWAYS_SOFTWARE=1
export GALLIUM_DRIVER=softpipe

echo "[1/5] Preparing temporary directories"

mkdir -p /tmp/.X11-unix
mkdir -p /tmp/runtime-user

chmod 1777 /tmp
chmod 1777 /tmp/.X11-unix
chmod 700 /tmp/runtime-user

chown user:user /tmp/runtime-user
chown -R user:user /home/user

rm -f /tmp/.X11-unix/X0
rm -f /tmp/.X0-lock

echo "[2/5] Starting Xorg"

/usr/bin/Xorg :0 -noreset -nolisten tcp &
xorg_pid=$!

cleanup() {
  kill "$xorg_pid" 2>/dev/null || true
}

trap cleanup EXIT INT TERM

echo "[3/5] Waiting for display :0"

attempt=0

while [ ! -S /tmp/.X11-unix/X0 ]
do
  if ! kill -0 "$xorg_pid" 2>/dev/null
  then
    echo "ERROR: Xorg stopped before creating display :0"
    wait "$xorg_pid"
    exit 1
  fi

  attempt=$((attempt + 1))

  if [ "$attempt" -ge 60 ]
  then
    echo "ERROR: Xorg did not create display :0 after 60 seconds"
    exit 1
  fi

  sleep 1
done

echo "[4/5] Xorg display is ready"
echo "[5/5] Starting XFCE session"

exec su-exec user env \
  HOME=/home/user \
  USER=user \
  LOGNAME=user \
  SHELL=/bin/sh \
  DISPLAY=:0 \
  XDG_RUNTIME_DIR=/tmp/runtime-user \
  LIBGL_ALWAYS_SOFTWARE=1 \
  GALLIUM_DRIVER=softpipe \
  dbus-run-session /usr/bin/xfce4-session
