#!/bin/sh
set -u

export DISPLAY=:0
export HOME=/home/user
export USER=user
export LOGNAME=user
export SHELL=/bin/sh
export XDG_RUNTIME_DIR=/tmp/runtime-user
export LIBGL_ALWAYS_SOFTWARE=1
export GALLIUM_DRIVER=softpipe

xorg_log=/tmp/webvm-xorg.log
xrandr_log=/tmp/webvm-xrandr.log

echo "[1/5] Preparing XFCE environment"

mkdir -p /tmp/.X11-unix
mkdir -p /tmp/runtime-user

chmod 1777 /tmp
chmod 1777 /tmp/.X11-unix
chmod 700 /tmp/runtime-user

chown user:user /tmp/runtime-user
chown -R user:user /home/user

rm -f /tmp/.X11-unix/X0
rm -f /tmp/.X0-lock
rm -f "$xorg_log"
rm -f "$xrandr_log"

echo "[2/5] Starting Xorg on graphical VT7"

/usr/bin/Xorg \
  :0 \
  vt7 \
  -keeptty \
  -noreset \
  -nolisten tcp \
  -ac \
  >"$xorg_log" 2>&1 &

xorg_pid=$!

cleanup() {
  kill "$xorg_pid" 2>/dev/null || true
}

trap cleanup EXIT INT TERM

echo "[3/5] Waiting for accessible display :0"

attempt=0

while true
do
  if ! kill -0 "$xorg_pid" 2>/dev/null
  then
    echo "ERROR: Xorg stopped."
    cat "$xorg_log"
    wait "$xorg_pid"
    exit 1
  fi

  if su-exec user env DISPLAY=:0 /usr/bin/xrandr --query \
    >"$xrandr_log" 2>&1
  then
    break
  fi

  attempt=$((attempt + 1))

  if [ "$attempt" -ge 90 ]
  then
    echo "ERROR: user could not access display :0."
    echo
    echo "Xorg log:"
    cat "$xorg_log"
    echo
    echo "xrandr result:"
    cat "$xrandr_log"
    exit 1
  fi

  sleep 1
done

echo "[4/5] Display :0 is accessible"
echo "[5/5] Launching XFCE session"

exec su-exec user env \
  HOME=/home/user \
  USER=user \
  LOGNAME=user \
  SHELL=/bin/sh \
  DISPLAY=:0 \
  XDG_RUNTIME_DIR=/tmp/runtime-user \
  XDG_CURRENT_DESKTOP=XFCE \
  DESKTOP_SESSION=xfce \
  LIBGL_ALWAYS_SOFTWARE=1 \
  GALLIUM_DRIVER=softpipe \
  dbus-run-session /usr/bin/xfce4-session
