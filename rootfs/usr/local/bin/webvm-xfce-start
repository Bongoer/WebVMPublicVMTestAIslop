#!/bin/sh
set -u

export HOME=/root
export USER=root
export LOGNAME=root
export SHELL=/bin/sh
export DISPLAY=:0

xorg_pid=""

cleanup() {
  [ -n "$xorg_pid" ] && kill "$xorg_pid" 2>/dev/null || true
}

trap cleanup EXIT INT TERM

echo "[1/6] Preparing XFCE display"

mkdir -p /tmp/.X11-unix
mkdir -p /tmp/.ICE-unix
mkdir -p /tmp/runtime-user

chmod 1777 /tmp
chmod 1777 /tmp/.X11-unix
chmod 1777 /tmp/.ICE-unix
chmod 700 /tmp/runtime-user

chown user:user /tmp/runtime-user
chown -R user:user /home/user

rm -f /tmp/.X11-unix/X0
rm -f /tmp/.X0-lock

echo "[2/6] Starting Xorg without GLX"

/usr/bin/Xorg \
  :0 \
  vt7 \
  -keeptty \
  -noreset \
  -nolisten tcp \
  -ac \
  -extension GLX &

xorg_pid=$!

echo "[3/6] Waiting for XFCE display"

attempt=0

while [ ! -S /tmp/.X11-unix/X0 ]
do
  if ! kill -0 "$xorg_pid" 2>/dev/null
  then
    echo "ERROR: Xorg stopped."
    wait "$xorg_pid"
    exit 1
  fi

  attempt=$((attempt + 1))

  if [ "$attempt" -ge 60 ]
  then
    echo "ERROR: Xorg did not create display :0."
    exit 1
  fi

  sleep 1
done

echo "[4/6] Starting XFCE window manager"

exec su-exec user env \
  HOME=/home/user \
  USER=user \
  LOGNAME=user \
  SHELL=/bin/sh \
  DISPLAY=:0 \
  XDG_RUNTIME_DIR=/tmp/runtime-user \
  XDG_CONFIG_HOME=/home/user/.config \
  XDG_CURRENT_DESKTOP=XFCE \
  DESKTOP_SESSION=xfce \
  dbus-run-session sh -c '
    /usr/bin/xfwm4 \
      --replace \
      --compositor=off \
      >/tmp/xfwm4.log 2>&1 &

    wm_pid=$!

    sleep 4

    if ! kill -0 "$wm_pid" 2>/dev/null
    then
      echo "ERROR: xfwm4 stopped."
      cat /tmp/xfwm4.log
      exit 1
    fi

    echo "[5/6] Starting XFCE desktop"

    /usr/bin/xfsettingsd \
      --replace \
      >/tmp/xfsettingsd.log 2>&1 &

    /usr/bin/thunar \
      --daemon \
      >/tmp/thunar.log 2>&1 &

    /usr/bin/xfdesktop \
      >/tmp/xfdesktop.log 2>&1 &

    sleep 3

    echo "[6/6] Starting XFCE panel"

    /usr/bin/xfce4-panel \
      --disable-wm-check \
      >/tmp/xfce4-panel.log 2>&1 &

    panel_pid=$!

    sleep 5

    if ! kill -0 "$panel_pid" 2>/dev/null
    then
      echo "ERROR: XFCE panel stopped."
      cat /tmp/xfce4-panel.log
      exit 1
    fi

    echo "Pure XFCE desktop is running."

    wait "$wm_pid"
  '
